{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "tabWidth": 4,
  "useTabs": false,
  "semi": true,
  "jsdoc": {},
  "singleQuote": false,
  "trailingComma": "all",
  "ignorePatterns": ["dist", "pnpm-lock.yaml"],
  "overrides": [
    {
      "files": ["*.json"],
      "options": {
        "tabWidth": 2
      }
    }
  ]
}
